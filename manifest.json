{
  "manifest_version": 3,
  "name": "DOMLens",
  "version": "0.1.0",
  "description": "Hold a hotkey and hover any element to see its tag, size, colors, and fonts. Press C to copy its CSS selector.",
  "minimum_chrome_version": "88",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DOMLens — open options to configure the hotkey",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/shared/settings.js",
        "src/shared/info-fields.js",
        "src/shared/element-copy.js",
        "src/content/overlay.js",
        "src/content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
